    {
      "id": "_VwzAJHryK0jtISwCksL0",
      "type": "text",
      "x": -2402.9168007892195,
      "y": 879.9589843749994,
      "width": 77.65034993489527,
      "height": 112.1249999999999,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
