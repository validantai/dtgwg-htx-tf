      "roundness": null,
      "seed": 592132620,
      "version": 803,
      "versionNonce": 343869054,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787138440080,
      "link": null,
      "locked": false,
      "text": "Gina gets an\nemail from Linus\nannouncing that\nthe Kubernetes\nproject will follow\nthe Kernel project\nin adopting a\nreplacement for\nthe existing Web\nof Trust",
      "fontSize": 9.749999999999991,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Gina gets an email from Linus announcing that the Kubernetes project will follow the Kernel project in adopting a replacement for the existing Web of Trust",
      "autoResize": false,
      "lineHeight": 1.15
    },
