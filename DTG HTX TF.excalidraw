      "x": -2018.1136685309207,
      "y": 954.6118067131741,
      "width": 77.65034993489527,
      "height": 11.21249999999999,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
