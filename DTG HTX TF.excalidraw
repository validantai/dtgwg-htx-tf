      "versionNonce": 609333282,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787138533437,
      "link": null,
      "locked": false,
      "text": "Needs to know\nwhat a VTA is\n(video tutorials?)\n\nNeeds to know\nwhat it does for\nthe community\n\nNeeds an\noverview of the\nprocess she'll\nneed to follow \n\nNeeds to know\nhow to initiate the\nprocess\n\nCan now respond\nwith feasibility - a\ntimeline that will\nwork for the\ncommunity\n\nway to provide\nfeedback in\ncontext",
      "fontSize": 9.749999999999991,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Needs to know what a VTA is (video tutorials?)\n\nNeeds to know what it does for the community\n\nNeeds an overview of the process she'll need to follow \n\nNeeds to know how to initiate the process\n\nCan now respond with feasibility - a timeline that will work for the community\n\nway to provide feedback in context",
      "autoResize": false,
      "lineHeight": 1.15
    },
