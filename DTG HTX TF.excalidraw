      "boundElements": [],
      "updated": 1787138533437,
      "link": null,
      "locked": false,
      "text": "Kevin's guess on\nsequence:\n\nSelf DID\nSelf VTA\n\nCommunity DID\nRoot Credential\n(community\nadmin credential)\nSelf VMC (if RC\ndoes not include\na community\nmembership\ncredential)\nCommunity VTA\n\nGovernance\nFramework",
      "fontSize": 9.749999999999991,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Kevin's guess on sequence:\n\nSelf DID\nSelf VTA\n\nCommunity DID\nRoot Credential (community admin credential)\nSelf VMC (if RC does not include a community membership credential)\nCommunity VTA\n\nGovernance Framework",
      "autoResize": false,
      "lineHeight": 1.15
    },
