    {
      "id": "cl78fjf1YRTvCRlBfPr8c",
      "type": "text",
      "x": -3802.7599844359993,
      "y": 1876.0171146499326,
      "width": 634.0087890624999,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0e",
      "roundness": null,
      "seed": 450926604,
      "version": 357,
      "versionNonce": 2131508660,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786468165240,
      "link": null,
      "locked": false,
      "text": "One founder instantiates the community and automatically becomes the first member.\nThey set the initial rules for who can join. No onboarding of others yet — this is the\nseed.\n\nThe founder invites a small, hand-picked group of trusted people (the maintainers who\nwill grow the community responsibly). They exchange verified credentials to confirm\nthe relationship. Bar to join: a direct invitation from the founder.\n\n",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "One founder instantiates the community and automatically becomes the first member. They set the initial rules for who can join. No onboarding of others yet — this is the seed.\n\nThe founder invites a small, hand-picked group of trusted people (the maintainers who will grow the community responsibly). They exchange verified credentials to confirm the relationship. Bar to join: a direct invitation from the founder.\n\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
