      "locked": false,
      "text": "RUNA ",
      "fontSize": 84.32291666666659,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "RUNA ",
      "autoResize": true,
      "lineHeight": 1.15
    },
    {
      "id": "HDMnZr7zYWT58g78NMAb-",
      "type": "text",
      "x": -2263.489395698021,
      "y": 765.2909648087048,
      "width": 482.3109436035156,
      "height": 85.31770833333394,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#1e1e1e",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "ngSAM_W8pQrdYBLfXHxNw",
      "index": "b05zzzzzzzyW",
      "roundness": null,
      "seed": 1587196852,
      "version": 1809,
      "versionNonce": 1234931810,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787138533437,
      "link": null,
      "locked": false,
      "text": "38, Core Maintainer of the Kubernetes Project, lives in Delhi\nPossesses deep, foundational knowledge of software security\nHas just received the directive from Linus that Kubernetes will follow the Kernel team \nin replacing their Web of Trust with DTG-based authentication and proof of personhood. \nIt's Runa's job to make this happen.\n",
      "fontSize": 12.364885265700572,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "38, Core Maintainer of the Kubernetes Project, lives in Delhi\nPossesses deep, foundational knowledge of software security\nHas just received the directive from Linus that Kubernetes will follow the Kernel team \nin replacing their Web of Trust with DTG-based authentication and proof of personhood. \nIt's Runa's job to make this happen.\n",
      "autoResize": true,
      "lineHeight": 1.15
    },
    {
      "id": "7hGoXq37HjiEvxbLlVTcf",
      "type": "text",
      "x": -2496.1546521028536,
      "y": 852.0861111111114,
      "width": 492.6310119628906,
      "height": 85.31770833333394,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#1e1e1e",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "ngSAM_W8pQrdYBLfXHxNw",
      "index": "b05zzzzzzzyWV",
      "roundness": null,
      "seed": 1997139340,
      "version": 1708,
      "versionNonce": 1232646946,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787138440080,
      "link": null,
      "locked": false,
      "text": "38, Core Maintainer of the Kubernetes Project\nPossesses deep, foundational knowledge of software security\nHas just received the directive from Linus that Kubernetes will follow the Kernel team \nin replacing their Web of Trust with a DTG-based authentication and proof of personhood. \nIt's Gina's job to make this happen.\n",
      "fontSize": 12.364885265700572,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "38, Core Maintainer of the Kubernetes Project\nPossesses deep, foundational knowledge of software security\nHas just received the directive from Linus that Kubernetes will follow the Kernel team \nin replacing their Web of Trust with a DTG-based authentication and proof of personhood. \nIt's Gina's job to make this happen.\n",
      "autoResize": true,
      "lineHeight": 1.15
    },
    {
      "id": "6vny_9J7Pc0UcKvfhiuer",
      "type": "text",
      "x": -1764.6018791028407,
      "y": 766.0412903295381,
      "width": 497.929931640625,
      "height": 99.5373263888896,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#1e1e1e",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "ngSAM_W8pQrdYBLfXHxNw",
      "index": "b05zzzzzzzyX",
      "roundness": null,
      "seed": 823698484,
      "version": 2509,
      "versionNonce": 1542299326,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787138533437,
      "link": null,
      "locked": false,
      "text": "GOALS: \n- to make the Kubernetes project less vulnerable to bad actors and unhelpful AI\n- to promote or emphasize the strength of Kubernetes... de-risking it for enterprise\n- to understand the advantages/differences between a DTG approach and the Web of Trust\n- to successfully initiate OpenVTC for her community\n- to make adoption as quick and painless as possible for her team\n",
      "fontSize": 12.364885265700572,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "GOALS: \n- to make the Kubernetes project less vulnerable to bad actors and unhelpful AI\n- to promote or emphasize the strength of Kubernetes... de-risking it for enterprise\n- to understand the advantages/differences between a DTG approach and the Web of Trust\n- to successfully initiate OpenVTC for her community\n- to make adoption as quick and painless as possible for her team\n",
      "autoResize": true,
      "lineHeight": 1.15
    },
