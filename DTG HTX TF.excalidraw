      "text": "ONE NODE, one VTA.\n- a person has one\n- a community has one\n- a device has one\n- an agent has one",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ONE NODE, one VTA.\n- a person has one\n- a community has one\n- a device has one\n- an agent has one",
      "autoResize": true,
      "lineHeight": 1.25
    },
